{
  "name": "rpp-docs-portal",
  "version": "0.0.0",
  "private": true,
  "description": "Central multi-app, multi-version documentation portal for Rocket Pad Platforms",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "tsx scripts/sync-versions.ts",
    "sync:dry": "tsx scripts/sync-versions.ts --dry-run",
    "fetch:docs": "tsx scripts/fetch-docs.ts",
    "prepare:docs": "tsx scripts/prepare-docs.ts",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve --dir build",
    "dev:local": "tsx scripts/dev-local.ts",
    "check:size": "tsx scripts/check-size.ts",
    "check:build": "tsx scripts/check-build.ts",
    "check:legacy": "tsx scripts/check-legacy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "clsx": "2.1.1",
    "jiti": "2.7.0",
    "mermaid": "12.2.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/semver": "7.8.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
